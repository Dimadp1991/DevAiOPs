cat << 'EOF' > /tmp/alertmanager.yaml
global:
  resolve_timeout: 5m
inhibit_rules: []
receivers:
- name: "null"
- name: "aiops-webhook"
  webhook_configs:
  - url: 'http://aiops.app.local/api/v1/alerts/webhook'
    send_resolved: true
route:
  group_by:
  - namespace
  group_interval: 5m
  group_wait: 30s
  receiver: "aiops-webhook"
  repeat_interval: 12h
  routes:
  - matchers:
    - alertname = "Watchdog"
    receiver: "null"
templates:
- /etc/alertmanager/config/*.tmpl
EOF

kubectl create secret generic alertmanager-prometheus-kube-prometheus-alertmanager \
  --from-file=alertmanager.yaml=/tmp/alertmanager.yaml \
  -n monitoring \
  --dry-run=client -o yaml | kubectl apply -f -

rm /tmp/alertmanager.yaml