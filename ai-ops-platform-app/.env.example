# Backend
USE_MOCK_PROVIDERS=false
AGENT_ENABLED=true
AUTO_ENRICH_ON_ALERT=true
SEED_DEMO_INCIDENT=false
DEBUG=false

KUBERNETES_NAMESPACE=default

PROMETHEUS_URL=http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090
DCGM_EXPORTER_URL=http://nvidia-dcgm-exporter.gpu-operator.svc.cluster.local:9400
LOKI_URL=
QDRANT_URL=

DATABASE_URL=postgresql://aiops:aiops@localhost:5432/aiops

# vLLM / Qwen (OpenAI-compatible)
LLM_API_URL=http://aiops-llm.devops-core.svc.cluster.local/v1
LLM_MODEL=qwen
LLM_API_KEY=

# UI
AIOPS_API_URL=http://localhost:8000
