# 1. Generate the CDI spec for NVIDIA on WSL2
sudo mkdir -p /etc/cdi
sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml

# 2. Configure containerd to use CDI and the NVIDIA runtime hook
sudo nvidia-ctk runtime configure --runtime=containerd --config=/var/lib/rancher/rke2/agent/etc/containerd/config.toml

# 3. Restart RKE2 agent to apply the runtime changes
sudo systemctl restart rke2-agent